# ==============================================================================
# Student Performance Prediction Dashboard - Environment Configuration
# ==============================================================================

# Backend Configuration
PORT=5000
FLASK_ENV=development
SECRET_KEY=your-jwt-secret-key-change-in-production

# Supabase PostgreSQL Configuration (Optional - SQLite is used out-of-the-box if omitted)
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-do-not-expose-to-frontend

# Frontend Configuration (Vite)
VITE_SUPABASE_URL=https://your-supabase-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key
